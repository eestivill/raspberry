# =============================================================================
# Variables de Entorno - Infraestructura Docker Raspberry Pi 4
# =============================================================================
# Copiar este archivo como .env y configurar los valores según tu entorno:
#   cp .env.example .env
#
# IMPORTANTE: El archivo .env contiene secretos y NO debe subirse al control
# de versiones. Está excluido en .gitignore.
# =============================================================================

# --- Almacenamiento ---
# Ruta base donde se almacenan los volúmenes persistentes de los contenedores.
# Debe ser una ruta absoluta con permisos de lectura y escritura.
# Por defecto se usa ./volumes si no se define.
VOLUMES_PATH=./volumes

# --- Red ---
# Nombre de la red interna Docker para comunicación entre contenedores.
NETWORK_NAME=rpi4_internal

# --- Monitoreo ---
# Intervalo en segundos entre verificaciones de salud de contenedores.
MONITOR_INTERVAL=30

# Ruta donde se almacenan los logs del monitor de salud.
LOGS_PATH=./logs

# --- Seguridad ---
# Usuario por defecto para ejecutar contenedores (UID:GID).
# Se recomienda un usuario no-root (UID >= 1000).
CONTAINER_USER=1000:1000

# Límite de CPU por defecto para contenedores (en núcleos).
DEFAULT_CPU_LIMIT=1.0

# Límite de memoria por defecto para contenedores.
DEFAULT_MEMORY_LIMIT=512M

# --- Pi-hole ---
# Contraseña para el panel de administración web de Pi-hole.
PIHOLE_WEBPASSWORD=changeme

# Zona horaria para Pi-hole (formato: Region/Ciudad).
PIHOLE_TZ=Europe/Madrid

# --- Ntfy ---
# Hostname o IP de la Raspberry (para URLs de notificaciones).
NTFY_HOST=localhost

# --- n8n ---
# Hostname o IP donde n8n es accesible.
N8N_HOST=0.0.0.0
